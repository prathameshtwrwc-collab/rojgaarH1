VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# HanuOTP (SMS for phone verification) — see api/send-otp-sms.ts and src/lib/sms.ts
HANU_OTP_API_KEY=your-hanuotp-api-key
HANU_OTP_TEMPLATE_ID=your-hanuotp-template-id
VITE_HANU_OTP_API_KEY=your-hanuotp-api-key
VITE_HANU_OTP_TEMPLATE_ID=your-hanuotp-template-id

# Forgot password by SMS — see api/password-reset.ts and supabase/password-reset.sql.
# The service-role key is secret: set it in Vercel (and .env for local dev), never prefix it with VITE_.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
